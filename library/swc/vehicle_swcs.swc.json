          "frame_id": 217056512,
          "extended": true,
          "tx": [ { "bus": "Powertrain_Engine_Bus", "port": 2, "cycle_ms": 50 } ],
          "signals": [ "Current_Gear", "Transmission_Oil_Temp", "Ground_Speed" ]
        }
      ]
    },
